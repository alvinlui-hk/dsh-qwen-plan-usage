{
  "name": "@local/dsh-qwen-plan-usage",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Show Qwen Cloud Token Plan usage in DeepSeek Harness without using the inference API key.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alvinlui-hk/dsh-qwen-plan-usage.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "qwen",
    "token-plan"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-models",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
